# /etc/lcm/lcm.env (root:lcm 0640), installed by deploy/bootstrap.sh when
# missing. Non-secret settings only; every variable: README.md#configuration.
LCM_DATA_DIR=/var/lib/lcm
LCM_LISTEN=127.0.0.1:7800
# Browsers reach LCM through tailscale serve over HTTPS.
LCM_COOKIE_SECURE=true
LCM_LOG_FORMAT=json
LCM_LOG_LEVEL=info
LCM_SYSTEMCTL_PRIVILEGE=sudo -n
LCM_LOCK_TTL=1h
LCM_MEMORY_LIMIT=40MiB
