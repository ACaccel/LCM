# Written by the LCM deploy helper from its built-in template; do not edit.
[Unit]
Description=bots log-archive (managed by LCM)
After=network.target

[Service]
Type=simple
User=bots
Group=bots
SupplementaryGroups=bots-db
WorkingDirectory=/opt/bots/current
ExecStart=/opt/lcm/runtimes/node24/bin/node dist/bot/log-archive/index.js
EnvironmentFile=/etc/bots/env
EnvironmentFile=/etc/bots/log-archive.env
Environment=LCM_SERVICE=bots LCM_INSTANCE=log-archive
Environment=PATH=/opt/lcm/runtimes/node24/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
MemoryMax=1G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
InaccessiblePaths=-/var/lib/lcm -/etc/lcm -/var/lib/lcm-deploy -/var/lib/lcm-machine-power
SocketBindDeny=any
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
PrivateIPC=yes
ReadWritePaths=/var/lib/bots
InaccessiblePaths=-/var/lib/lcm-build -/var/cache/lcm-build

[Install]
WantedBy=multi-user.target
